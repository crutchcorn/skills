# Copy to .env and fill in. `pnpm eval` loads this via Node's --env-file-if-exists.

# Required. API key for an OpenAI-compatible chat completions endpoint.
EVAL_API_KEY=

# Required. Model that acts as the agent being evaluated.
EVAL_MODEL=

# Optional. Base URL of the OpenAI-compatible API. Default: https://api.openai.com/v1
# EVAL_BASE_URL=

# Optional. Model that grades behavior evals. Default: EVAL_MODEL
# EVAL_JUDGE_MODEL=
